CONTAINER_NAME=xray
# Если 443 занят Traefik, укажите другой свободный внешний порт.
XRAY_PORT=443
TARGET_HOST=www.bing.com
# Пустое значение включает автоопределение публичного IPv4.
SERVER_IP=
# Обязательный пароль репозитория Restic: задайте случайное значение и сохраните отдельно.
RESTIC_PASSWORD=
TZ=Europe/Moscow
