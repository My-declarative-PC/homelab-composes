CONTAINER_NAME=xray
# Базовый домен без схемы и поддомена xray: сайт и прокси доступны на xray.DOMAIN:443.
# Cloudflare A -> some IP, Proxied; SSL/TLS Full (strict).
DOMAIN=example.com
# Обязательный пароль репозитория Restic: задайте случайное значение и сохраните отдельно.
RESTIC_PASSWORD=
TZ=Europe/Moscow
